            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Portal do cliente\",\n  \"description\": \"Novo portal self-service\",\n  \"startDate\": \"2026-02-01\",\n  \"endDate\": \"2026-08-30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"status é PLANEJADO\", function () {",
                  "    pm.expect(jsonData.status).to.eql(\"PLANEJADO\");",
                  "});",
                  "pm.test(\"corpo não vaza cara de entidade JPA (sem campos internos)\", function () {",
                  "    pm.expect(Object.keys(jsonData).sort()).to.eql([\"description\",\"endDate\",\"id\",\"name\",\"startDate\",\"status\"]);",
                  "});",
                  "pm.collectionVariables.set(\"projectId\", jsonData.id);"
                ]
              }
            }
          ],
          "response": []
        },
