            },
            "url": { "raw": "{{baseUrl}}/api/milestones", "host": ["{{baseUrl}}"], "path": ["api", "milestones"] },
            "description": "Antes da Semana 6, isso 'funcionava' (projectId era só um Long solto, sem checagem). Depois de Milestone.project virar @ManyToOne de verdade, o service busca o Project e lança ResourceNotFoundException."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 404 Not Found\", () => pm.response.to.have.status(404));"
          ] } }]
        },
        {
          "name": "Criar milestone válida",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": {{projectId}},\n  \"name\": \"Entrega da fase 1\",\n  \"dueDate\": \"2026-04-15\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/milestones", "host": ["{{baseUrl}}"], "path": ["api", "milestones"] },
