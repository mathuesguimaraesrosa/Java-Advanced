            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Portal do cliente\",\n  \"description\": \"Novo portal self-service\",\n  \"startDate\": \"2026-02-01\",\n  \"endDate\": \"2026-08-30\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] },
            "description": "Guarda o id criado em {{projectId}} - todas as outras pastas dependem dele."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set(\"projectId\", json.id);"
          ] } }]
        },
        {
